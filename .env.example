# ============================================================
#  ازمونک — نمونه‌ی تنظیمات
#  این فایل را به .env کپی کنید و مقادیر را ویرایش کنید.
# ============================================================

# ------------------------------ سرور ------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=ازمونک
# آدرس عمومی برنامه (برای لینک دعوت‌نامه‌ها)
APP_URL=http://localhost:4000
# کلید امضای نشست‌ها — حتماً در محیط واقعی تغییر دهید
SESSION_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING
SESSION_TTL_HOURS=12
# اگر برنامه پشت Nginx/IIS اجرا می‌شود این را true کنید
TRUST_PROXY=false
CORS_ORIGINS=*

# ---------------------------- دیتابیس -----------------------------
# DB_MODE=mysql برای محیط عملیاتی (MySQL/MariaDB)
# DB_MODE=sqlite برای اجرای سریع و آزمایشی بدون نصب MySQL
DB_MODE=mysql
MYSQL_URL=mysql://azmoonak:Azmoonak@123@127.0.0.1:3306/azmoonak
SQLITE_FILE=./data/azmoonak.db
DB_POOL_SIZE=10

# -------------------------- هوش مصنوعی ---------------------------
# anthropic | openai | ollama | none
AI_PROVIDER=anthropic

# Anthropic (Claude) — پشتیبانی از عکس و PDF
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8000

# OpenAI یا هر سرویس سازگار با OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=8000

# Ollama محلی (مدل دیدبانی)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision
OLLAMA_MAX_TOKENS=8000

AI_TIMEOUT_MS=120000

# ------------------------------ فایل‌ها ----------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
# اگر دیتابیس MySQL نیست، با DB_MODE=sqlite اجرا کنید
